{
  "name": "garmin-video-studio",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "prepare-ride": "python3 scripts/prepare_ride.py",
    "demo": "node scripts/demo.mjs",
    "desktop:build": "node scripts/build_desktop.mjs",
    "desktop": "npm run desktop:build && electron desktop-dist",
    "desktop:smoke": "npm run desktop:build && electron desktop-dist --smoke",
    "desktop:package": "npm run desktop:build && node scripts/package_desktop.mjs",
    "test:regression": "node scripts/test_astra_review.mjs",
    "test:desktop-server": "node scripts/test_desktop_server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/saira": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@puppeteer/browsers": "3.2.3",
    "exifr": "7.1.3",
    "fit-file-parser": "6.1.2",
    "puppeteer-core": "25.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.10.0",
    "rolldown": "1.2.12",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
