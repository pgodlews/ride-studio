.DS_Store
__pycache__/
*.py[cod]
.venv/
.env
.env.*
/.cache/
/.claude/
/studio/desktop-dist/
/studio/release/
*.fit
*.FIT
*.[gG][pP][xX]
*.mov
*.MOV
*.m4v
*.M4V
*.mp4
