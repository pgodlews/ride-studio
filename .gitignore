# Keep activity archives, GPS records, audits and generated images local.
/telemetry-analysis/*
!/telemetry-analysis/tools/
/telemetry-analysis/tools/*
!/telemetry-analysis/tools/pull_edge.c
!/telemetry-analysis/tools/index_activities.py
!/telemetry-analysis/tools/PACKFADE-LICENSE

/video-studio/*
!/video-studio/render_hud.py
!/video-studio/README.md
!/video-studio/edit-plan.example.json

# Studio web app: dependencies, builds and local ride/media data stay local.
/studio/node_modules/
/studio/dist/
/studio/public/data/rides/*
/studio/public/data/media/*
!/studio/public/data/rides/.gitkeep
!/studio/public/data/media/.gitkeep
/studio/public/data/demo.json
/studio/.cache/
/studio/exports/
